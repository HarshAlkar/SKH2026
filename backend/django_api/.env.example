# Local default is SQLite (no DATABASE_URL needed).
# Cloud: paste the Postgres URL from Render / Railway / Neon.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Optional cloud media for profile photos (leave unset for local media/ folder).
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_CUSTOM_DOMAIN=your-bucket.s3.amazonaws.com

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com
