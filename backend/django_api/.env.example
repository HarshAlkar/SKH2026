# Local default is SQLite (no DATABASE_URL needed).
# Cloud: paste the Postgres URL from Render / Railway / Neon.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Required in production (DEBUG=False)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# DEBUG=True also allows any Host (phones on Wi-Fi). When DEBUG=False, list every hostname.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Production (Render): set concrete hosts — never use * when DEBUG=False
# ALLOWED_HOSTS=skh2026.onrender.com
# CSRF_TRUSTED_ORIGINS=https://skh2026.onrender.com
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOW_ALL=1  # only for local DEBUG convenience

# Token lifetime (hours) for ExpiringTokenAuthentication
TOKEN_TTL_HOURS=72

# Never enable in production — returns OTP in API JSON for local SMS-less testing
EXPOSE_OTP_FOR_DEV=0

# Gemini (server-side proxy only — never put in Flutter)
# Required for POST /api/ai/gemini-chat/, /api/ai/report-analysis/, GET /api/ai/status/
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-3.5-flash

# Google Places API (New) — server-side proxy only — never put in Flutter
# Enable "Places API (New)" in Google Cloud Console. Restrict this key to Places.
# Required for GET /api/places/nearby/ and GET /api/places/status/
# GOOGLE_PLACES_API_KEY=your-places-web-service-key
# NEARBY_RADIUS_M=5000

# Sync replay window
SYNC_TIMESTAMP_MAX_SKEW_DAYS=30

# Throttling (optional overrides)
# THROTTLE_LOGIN=10/min
# THROTTLE_OTP=5/min
# THROTTLE_GEMINI=20/min
# THROTTLE_PLACES=30/min

# Optional cloud media (private ACL + signed URLs)
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_CUSTOM_DOMAIN=your-bucket.s3.amazonaws.com

# SMS providers
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
